<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondomesademadera2"
    android:orientation="vertical"
    android:padding="@dimen/margen"
    tools:context=".TresEnRayaActivity">

    <TextView
        android:id="@+id/resultadoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="#000000" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="11dp" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/tableroGridLayout"
        android:layout_width="354dp"
        android:layout_height="354dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/fondo3enraya1"
        app:columnCount="3"
        app:rowCount="3">

        <ImageView
            android:id="@+id/esquinaIzqSupImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="0"
            app:layout_columnSpan="1"
            app:layout_row="0"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/superiorImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="1"
            app:layout_columnSpan="1"
            app:layout_row="0"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/esquinaDerSupImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="2"
            app:layout_columnSpan="1"
            app:layout_row="0"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/izquierdaImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="0"
            app:layout_columnSpan="1"
            app:layout_row="1"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/centroImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="1"
            app:layout_columnSpan="1"
            app:layout_row="1"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/derechaImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="2"
            app:layout_columnSpan="1"
            app:layout_row="1"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/esquinaIzqInfImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="0"
            app:layout_columnSpan="1"
            app:layout_row="2"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/inferiorImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="1"
            app:layout_columnSpan="1"
            app:layout_row="2"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />

        <ImageView
            android:id="@+id/esquinaDerInfImageView"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="@string/descripcionCasilla"
            app:layout_column="2"
            app:layout_columnSpan="1"
            app:layout_row="2"
            app:layout_rowSpan="1"
            app:srcCompat="@drawable/vacio" />
    </androidx.gridlayout.widget.GridLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="35dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/reiniciarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reiniciar_button" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_button" />
    </LinearLayout>
</LinearLayout>